{
  "name": "islands-of-insight-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build": "NODE_ENV=production bun run src/util/build.ts",
    "build:wasm": "bun run src/util/buildWasm.ts",
    "dev": "bun run src/util/serve.ts",
    "e2e": "bunx playwright test",
    "bench:sm": "bun run src/util/benchShiftingMosaic.ts",
    "fuzz:sm": "bun run src/util/fuzzShiftingMosaic.ts",
    "test:mem64": "node --test test/shifting-mosaic-solver/mem64.node.test.mjs",
    "rolling-blocks-test": "ROLLING_BLOCKS_TEST=true bun test test/rolling-blocks-solver/aStar.test.ts",
    "test": "bun run build:wasm && ROLLING_BLOCKS_TEST=true bun test"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@material/web": "^2.4.1",
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.3.12",
    "@types/emscripten": "^1.41.5",
    "sass": "^1.99.0",
    "tinyqueue": "^3.0.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  }
}
