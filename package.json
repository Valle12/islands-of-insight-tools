{
  "name": "islands-of-insight-tools",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build": "NODE_ENV=production bun run src/util/build.ts",
    "build:wasm": "bun run src/util/buildWasm.ts",
    "dev": "bun run src/util/serve.ts",
    "e2e": "bunx playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "bench:sm": "bun run src/util/benchShiftingMosaic.ts",
    "fuzz:sm": "bun run src/util/fuzzShiftingMosaic.ts",
    "bench:rb": "bun run src/util/benchRollingBlocks.ts",
    "fuzz:rb": "bun run src/util/fuzzRollingBlocks.ts",
    "bench:mt": "bun run src/util/benchMatchThree.ts",
    "fuzz:mt": "bun run src/util/fuzzMatchThree.ts",
    "test:mem64": "node --test test/shifting-mosaic-solver/mem64.node.test.mjs test/rolling-blocks-solver/mem64.node.test.mjs",
    "test": "bun run build:wasm && bun test",
    "test:fast": "IOI_SKIP_SLOW=1 bun test",
    "test:slow": "bun test slow",
    "test:changed": "bun test --changed=origin/main",
    "test:mt": "bun test test/match-three-solver test/configFile.test.ts test/utilMethods.test.ts",
    "test:pd": "bun test test/phasic-dial-solver test/configFile.test.ts test/utilMethods.test.ts",
    "test:rb": "bun test test/rolling-blocks-solver test/configFile.test.ts test/utilMethods.test.ts",
    "test:sm": "bun test test/shifting-mosaic-solver test/configFile.test.ts test/utilMethods.test.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@material/web": "^2.4.1",
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.3.12",
    "@types/emscripten": "^1.41.5",
    "sass": "^1.99.0",
    "tinyqueue": "^3.0.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.2"
  }
}
